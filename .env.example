# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit secrets.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Everything else stays server-only.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hostinger SMTP — used by src/app/api/contact/route.ts to send the
# contact form to CONTACT_TO_EMAIL. SMTP_USER/SMTP_PASS are the full
# mailbox address + password from hPanel > Emails.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@mpturai.lt
SMTP_PASS=
CONTACT_TO_EMAIL=info@mpturai.lt
